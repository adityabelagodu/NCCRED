# Copy to .env and fill in. Never commit the real .env.

# --- Anthropic (extraction) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Cloud (Speech-to-Text + Sheets) ---
# Path to a service-account JSON key with the Speech-to-Text API and Sheets API
# enabled. The same account's client email must be shared (Editor) into the sheet.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Workbook ---
# The quotation spreadsheet (defaults to the one you shared).
NCCRED_SPREADSHEET_ID=1pGnEoZA6kaFr75BP0DBcAJtsF4EFKPic7CRhnabNqh0
# The tab that holds one quote per row.
NCCRED_DATA_TAB=QUOTATIONS

# --- PDF / re-print ---
# The cell on the lookup tabs ("landscape"/"portrait") where the quote number is
# typed to fetch an older quote (used by --pull). Defaults to H4.
NCCRED_QUOTE_INPUT_CELL=H4
# Per-tab overrides, only if the two lookup tabs use different cells:
# NCCRED_QUOTE_INPUT_CELL_LANDSCAPE=C5
# NCCRED_QUOTE_INPUT_CELL_PORTRAIT=C5

# --- Optional overrides ---
# NCCRED_PDF_LANDSCAPE_MAX_ITEMS=8
# NCCRED_PDF_LATEST_LANDSCAPE_TAB=claude landscape
# NCCRED_PDF_LATEST_PORTRAIT_TAB=claude portrait
# NCCRED_PDF_LOOKUP_LANDSCAPE_TAB=landscape
# NCCRED_PDF_LOOKUP_PORTRAIT_TAB=portrait
# NCCRED_ANTHROPIC_MODEL=claude-opus-4-8
# NCCRED_STT_PRIMARY_LANGUAGE=kn-IN
# NCCRED_STT_ALTERNATE_LANGUAGES=hi-IN,en-IN
# NCCRED_RATE_EXTRA_PCT=1.0
# NCCRED_DEFAULT_GST_PCT=18.0
